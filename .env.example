# Monarch — environment config
# Copy this file to ".env" and fill in your key, then run:  python main.py
#
# Get a FREE Groq API key at https://console.groq.com  (API Keys → Create)

# Enables the AI coach, admin assistant, and feedback summaries.
# Without it, the app still runs and uses non-AI fallbacks.
GROQ_API_KEY=

# Optional: override the AI model. Default is a free Groq model.
# List models: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: admin panel password (default is "admin123").
# MONARCH_ADMIN_PASSWORD=admin123
